DATABASE_URL=postgresql://anivora:anivora@127.0.0.1:5435/anivora_dev
REDIS_URL=redis://127.0.0.1:6379

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

WEB_ORIGIN=http://localhost:3000
PORT=3001

BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=
BUNNY_STREAM_BASE_URL=https://video.bunnycdn.com
WEBHOOK_SECRET=

# Remote-upload worker scratch dir + max source size (bytes, default 20 GiB)
UPLOAD_WORK_DIR=./work
REMOTE_UPLOAD_MAX_BYTES=

# Authorized multi-provider mirroring. Native Anivora content remains available
# when disabled. Initial boot indexes pages 1-5; subsequent daily runs page 1.
MIRROR_ENABLED=false
MIRROR_INITIAL_PAGES=5
MIRROR_DAILY_PAGES=1
MIRROR_SYNC_INTERVAL_SECONDS=86400
MIRROR_RIGHTS_OWNER_NAME=
MIRROR_LICENSE_TYPE=authorized-mirror
MIRROR_PERMISSION_DOCUMENT_URL=
ANOBOY_BASE_URL=https://anoboy.be
GOFILE_API_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_POSTHOG_KEY=
