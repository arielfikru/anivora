{
	"name": "@anivora/api",
	"version": "1.1.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"dev": "tsx watch --env-file=../../.env.local src/main.ts",
		"start": "tsx --env-file=../../.env.local src/main.ts",
		"build": "tsc --noEmit",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:pull": "drizzle-kit pull",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx --env-file=../../.env.local src/db/seed.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1068.0",
		"@aws-sdk/lib-storage": "^3.1068.0",
		"@hono/node-server": "^1.19.11",
		"@orpc/json-schema": "^1.13.6",
		"@orpc/openapi": "^1.13.6",
		"@orpc/server": "^1.13.6",
		"@orpc/zod": "^1.13.6",
		"better-auth": "^1.5.3",
		"drizzle-kit": "^0.31.9",
		"drizzle-orm": "^0.45.1",
		"hono": "^4.12.9",
		"ioredis": "^5.10.1",
		"pg": "^8.16.3",
		"pino": "^9.5.0",
		"ts-pattern": "^5.9.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/pg": "^8.15.6",
		"dotenv": "^17.3.1",
		"tsx": "^4.21.0",
		"vite": "^7.3.1",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^3.0.5"
	}
}
