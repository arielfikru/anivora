{
	"name": "anivora",
	"version": "1.10.8",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.0.8",
	"scripts": {
		"dev": "moon run :dev",
		"dev:web": "moon run web:dev",
		"dev:api": "moon run api:dev",
		"build": "moon run :build",
		"test": "moon run :test",
		"check": "moon run :check",
		"lint": "moon run :lint",
		"format": "moon run :format",
		"db:generate": "pnpm --filter @anivora/api db:generate",
		"db:migrate": "pnpm --filter @anivora/api db:migrate",
		"db:push": "pnpm --filter @anivora/api db:push",
		"db:studio": "pnpm --filter @anivora/api db:studio",
		"db:seed": "pnpm --filter @anivora/api db:seed",
		"storybook": "pnpm --filter @anivora/web storybook",
		"dev:services": "docker compose -f docker-compose.dev.yml up -d",
		"dev:services:stop": "docker compose -f docker-compose.dev.yml down"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@types/node": "^22.10.2",
		"typescript": "^5.7.2"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"core-js",
			"esbuild",
			"lightningcss",
			"protobufjs"
		]
	}
}
